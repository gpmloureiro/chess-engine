{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Chess Engine",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-g",
                "-fdiagnostics-color=always",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/game.cpp",
                "${workspaceFolder}/src/board.cpp",
                "${workspaceFolder}/src/renderer.cpp",
                "${workspaceFolder}/src/movegen.cpp",
                "-o",
                "${workspaceFolder}/chess.exe",
                "-I", "C:/msys64/ucrt64/include",
                "-L", "C:/msys64/ucrt64/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}